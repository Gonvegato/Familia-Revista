<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_cobre_bg"/>
    <foreground android:drawable="@drawable/ic_launcher_cobre_fg"/>
    <monochrome android:drawable="@drawable/ic_launcher_cobre_mono"/>
</adaptive-icon>
