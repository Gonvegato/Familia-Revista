<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Ver todas las apps que tienes (para pintarlas en la pantalla de inicio) y las pantallas de inicio que hay (para pasar a la de siempre) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Actualizarse sola desde tu kDrive (Actualizador.kt): bajar la versión nueva, instalarla y reabrirse después -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pedir que Android no cierre Ammit para ahorrar batería (si la cierra, el vigilante sale «No funcionando») -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Ofrecer el botón de la barra de arriba con un toque (Android 13+) no pide permiso; poner los widgets de la familia sí lo pide al ponerlos -->
    <application
        android:name=".AmmitApp"
        android:label="Ammit"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Ammit"
        android:allowBackup="false">

        <!-- La pantalla de inicio: con Ammit encendido, tu fondo, tus apps (la familia en color, las demás encadenadas) y los widgets de
             la familia; apagado, pasa sin más a tu pantalla de inicio de siempre -->
        <activity android:name=".InicioActivity" android:exported="true" android:launchMode="singleTask"
            android:theme="@style/Ammit.Inicio" android:excludeFromRecents="true" android:stateNotNeeded="true"
            android:resumeWhilePausing="true" android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density" />

        <!-- Ammit como pantalla de inicio de la tablet: no hace falta (encendida, el vigilante te lleva a la suya) y en algunos móviles
             (ColorOS) empeora los gestos; por eso viene quitado y solo se pone si lo eliges en sus ajustes -->
        <activity-alias android:name=".InicioCasa" android:targetActivity=".InicioActivity" android:exported="true" android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <!-- Lo que se ve en el cajón de apps: los pasos para dejarlo listo y el interruptor -->
        <activity android:name=".AjustesActivity" android:exported="true" android:taskAffinity="com.gonzalo.ammit.ajustes"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Mantener pulsado el botón de la barra de arriba abre esto -->
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" /></intent-filter>
        </activity>

        <!-- «X no pasa el juicio»: las cadenas, Ammit y el sinfín de cadenas, que acaba siendo el fondo de la pantalla de inicio -->
        <activity android:name=".JuicioActivity" android:exported="false" android:theme="@style/Ammit.Juicio"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="com.gonzalo.ammit.juicio" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density" />

        <!-- «Ammit no te suelta»: al intentar apagarla sin haber escrito 300 palabras ni leído un capítulo -->
        <activity android:name=".CandadoActivity" android:exported="false" android:theme="@style/Ammit.Juicio"
            android:excludeFromRecents="true" android:taskAffinity="com.gonzalo.ammit.candado" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density" />

        <!-- Al apagar: una capa transparente encima de tu inicio de siempre, con las cadenas yéndose -->
        <activity android:name=".SalidaActivity" android:exported="false" android:theme="@style/Ammit.Salida"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="com.gonzalo.ammit.salida"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density" />

        <!-- Pliega la barra de arriba al encender (y se va sin enseñar nada): las cadenas de la cortina tapan lo de debajo -->
        <activity android:name=".PlegarActivity" android:exported="false" android:theme="@style/Ammit.Salida"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="com.gonzalo.ammit.plegar" />

        <!-- El widget de Ammit y lo que hace su toque (encender, o soltarla si ya se puede) -->
        <receiver android:name=".WidgetAmmit" android:exported="true" android:label="Ammit">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_ammit" />
        </receiver>
        <activity android:name=".InterruptorActivity" android:exported="false" android:theme="@style/Ammit.Salida"
            android:excludeFromRecents="true" android:noHistory="true" android:taskAffinity="com.gonzalo.ammit.interruptor" />

        <!-- El botón de la barra de arriba -->
        <service android:name=".BotonAmmit" android:exported="true" android:label="Ammit" android:icon="@drawable/ic_balanza"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="true" />
        </service>

        <!-- El que vigila qué app se abre (servicio de accesibilidad): si no es de la familia, el juicio -->
        <service android:name=".Vigia" android:exported="true" android:label="Ammit"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/vigia" />
        </service>
        <receiver android:name=".ActualizadorReceiver" android:exported="false" />
        <receiver android:name=".ActualizadorReabrir" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
    </application>
</manifest>
