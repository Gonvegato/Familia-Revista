<?xml version="1.0" encoding="utf-8"?>
<!-- Un widget de Ptah: el dibujo (claro, oscuro, o los dos y el sistema elige), encima lo que se mueve solo (la hora, las agujas) y las zonas para tocar -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView android:id="@+id/w_img" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/w_dia" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="@integer/w_dia" />
    <ImageView android:id="@+id/w_noche" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:importantForAccessibility="no" android:visibility="@integer/w_noche" />
    <FrameLayout android:id="@+id/w_vivos" android:layout_width="match_parent" android:layout_height="match_parent" />
    <FrameLayout android:id="@+id/w_vivos_dia" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="@integer/w_dia" />
    <FrameLayout android:id="@+id/w_vivos_noche" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="@integer/w_noche" />
    <FrameLayout android:id="@+id/w_zonas" android:layout_width="match_parent" android:layout_height="match_parent" />
</FrameLayout>
