<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Actualizarse sola desde tu kDrive (Actualizador.kt): instalar la versión nueva de sí misma, y reabrirse después -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 13 o más: sin este permiso no se ven los avisos del actualizador («tienes una versión nueva», «se ha actualizado») -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Para leer los colores de Atrio (su ContentProvider de colores) -->
    <queries>
        <!-- Desde Android 11 una app no ve a las demás si no las declara aquí: sin esto, «Leer en Marfil», «Jugar en Hiedra» o «Escribir en Cobalto» no salen nunca en un móvil de verdad (getLaunchIntentForPackage devuelve null) -->
        <package android:name="com.gonzalo.hiedra" />
        <package android:name="com.gonzalo.marfil" />
        <package android:name="com.gonzalo.gamerate" />
        <provider android:authorities="com.gonzalo.gamerate.tema" />
    </queries>
    <application
        android:label="Cobalto"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Cobalto"
        android:allowBackup="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Al poner el widget «Sigue escribiendo»: elegir qué obra abre -->
        <activity android:name=".ConfigWidgetActivity" android:exported="true" android:theme="@style/Cobalto">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" /></intent-filter>
        </activity>
        <!-- Exportar a PDF y compartir archivos -->
        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.archivos" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/archivos" />
        </provider>
        <receiver android:name=".ActualizadorReceiver" android:exported="false" />
        <receiver android:name=".ActualizadorReabrir" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
        <receiver android:name=".WHoy" android:label="@string/w_hoy" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_hoy" />
        </receiver>
        <receiver android:name=".WObra" android:label="@string/w_obra" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_obra" />
        </receiver>
        <receiver android:name=".WCita" android:label="@string/w_cita" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_cita" />
        </receiver>
        <receiver android:name=".WMarca" android:label="@string/w_marca" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_marca" />
        </receiver>
        <receiver android:name=".WMarcaPapel" android:label="@string/w_marcapapel" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/w_marcapapel" />
        </receiver>
    </application>
</manifest>
