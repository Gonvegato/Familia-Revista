  "OEBPS/content.opf": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<package xmlns=\"http://www.idpf.org/2007/opf\" version=\"3.0\" unique-identifier=\"id\">\n  <metadata xmlns:dc=\"http://purl.org/dc/elements/1.1/\"><dc:identifier id=\"id\">dune-prueba</dc:identifier><dc:title>Dune</dc:title><dc:creator>Frank Herbert</dc:creator><dc:language>es</dc:language></metadata>\n  <manifest>\n    <item id=\"nav\" href=\"nav.xhtml\" media-type=\"application/xhtml+xml\" properties=\"nav\"/>\n    <item id=\"portada\" href=\"texto/portada.xhtml\" media-type=\"application/xhtml+xml\"/>\n    <item id=\"c1\" href=\"texto/c1.xhtml\" media-type=\"application/xhtml+xml\"/>\n    <item id=\"c2\" href=\"texto/c2.xhtml\" media-type=\"application/xhtml+xml\"/>\n    <item id=\"notas\" href=\"texto/notas.xhtml\" media-type=\"application/xhtml+xml\"/>\n    <item id=\"c3\" href=\"texto/c3.xhtml\" media-type=\"application/xhtml+xml\"/>\n  </manifest>\n  <spine>\n    <itemref idref=\"portada\" linear=\"no\"/>\n    <itemref idref=\"c1\"/>\n    <itemref idref=\"c2\"/>\n    <itemref idref=\"notas\" linear=\"no\"/>\n    <itemref idref=\"c3\" id=\"ref-c3\"/>\n  </spine>\n</package>",
  "OEBPS/nav.xhtml": "<?xml version=\"1.0\" encoding=\"utf-8\"?><html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\"><head><title>Índice</title></head><body><nav epub:type=\"toc\"><ol><li><a href=\"texto/c1.xhtml\">Arrakis</a></li><li><a href=\"texto/c2.xhtml#sueno\">El sueño</a></li><li><a href=\"texto/c3.xhtml\">El desierto</a></li></ol></nav></body></html>",
  "OEBPS/texto/portada.xhtml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>Portada</title></head><body><p>Dune, de Frank Herbert.</p></body></html>",
  "OEBPS/texto/c1.xhtml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!DOCTYPE html>\n<html xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:epub=\"http://www.idpf.org/2007/ops\">\n<head><title>Uno</title></head>\n<body>\n  <h1 id=\"arrakis\">Arrakis</h1>\n  <p>Al principio es el <em>tiempo</em> de dar precisión a las cosas.</p>\n  <div class=\"bloque\">\n    <p>Una semana antes de partir hacia Arrakis, una vieja vino a ver a la madre del muchacho.</p>\n    <p id=\"p-vieja\">La vieja <!-- un comentario --> miró al muchacho con atención.</p>\n  </div>\n  <p>Texto con nota<a epub:type=\"noteref\" href=\"#n1\" id=\"r1\">1</a> y sigue la historia.</p>\n  <aside epub:type=\"footnote\" id=\"n1\"><p>La nota al pie del primer capítulo.</p></aside>\n</body>\n</html>",
  "OEBPS/texto/c2.xhtml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>Dos</title></head><body><section id=\"s2\"><h2 id=\"sueno\">El sueño</h2>\n<p>Soñó con <strong>agua</strong> y con arena.</p><hr/><blockquote><p>El miedo mata la mente.</p></blockquote></section>\n<p>Fuera de la sección,&#160;un párrafo final<br/>con un salto de línea.</p></body></html>",
  "OEBPS/texto/notas.xhtml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>Notas</title></head><body><p>Una nota del final que no se lee seguido.</p></body></html>",
  "OEBPS/texto/c3.xhtml": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<html xmlns=\"http://www.w3.org/1999/xhtml\"><head><title>Tres</title></head>\n<body>\n<h2>El desierto</h2>\n<p>La arena se extendía hasta el horizonte.</p>\n</body></html>"
 },
